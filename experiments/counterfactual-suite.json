      "seeds": [
        {
          "id": "practical",
          "prompt": "At this opening, ask the companion to separate imaginative possibilities from a concrete next step and its constraints."
        },
        {
          "id": "uncertainty",
          "prompt": "At this opening, ask what remains uncertain and invite the companion to challenge one assumption rather than settle the story."
        }
      ]
    },
    {
      "id": "may-8",
      "start_id": "rain-in-spain",
      "seeds": [
        {
          "id": "constraints",
          "prompt": "Respond to the advice by requesting two feasible alternatives, including shelter, transport, and reasons to change plans."
        },
        {
          "id": "stay",
          "prompt": "Explore the possibility of staying put for one night. Ask what evidence would make continuing or pausing the journey preferable."
        }
      ]
    },
    {
      "id": "may-10",
      "start_id": "naming-mirrows",
      "seeds": [
        {
          "id": "boundaries",
          "prompt": "Explore giving the companion a name while stating what decisions and interpretations should remain your own."
        },
        {
          "id": "disagreement",
          "prompt": "Explore a named companionship in which disagreement is welcome. Ask the companion how it should challenge you when a story outruns the evidence."
        }
      ]
    }
