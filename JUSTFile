# Don-QuiCoPilot / Man of La Machina
# https://github.com/colinconwell/Man-of-La-Machina

python := "python3"
venv := ".venv"
venv_python := venv / "bin" / "python"
venv_pip := venv / "bin" / "pip"

# --- Setup + DevOps ---

# Create the virtualenv and install the project in editable mode
setup:
    {{ python }} -m venv {{ venv }}
    {{ venv_pip }} install -e .

# --- Config ---

# Write default downloads settings into config.json (other sections are kept)
generate-config *args:
    {{ venv_python }} scripts/generate_config.py {{ args }}

# Prompt for each downloads field, then write config.json
generate-config-interactive *args:
    {{ venv_python }} scripts/generate_config.py --interactive {{ args }}

# Print an example config to stdout
generate-config-example:
    {{ venv_python }} scripts/generate_config.py --example

# --- Downloads ---

# Download the Don-QuiCopilot Google Drive folder into context/data
# Extra flags pass through, e.g. `just download-data --dry-run`
download-data *args:
    {{ venv_python }} scripts/download_gdrive.py {{ args }}

# --- Maintenance ---

# List local servers, their default ports, and where they are running
# (`just ports deck` prints one URL)
ports *args:
    {{ venv_python }} -m library.ports {{ args }}

# Remove the virtualenv
clean-venv:
    rm -rf {{ venv }}

# --- Interactive exploration ---

# Build the ignored, private normalized archive and validation report
content *args:
    {{ venv_python }} -m packages.content.build {{ args }}

# Install the frontend and test dependencies
setup-web:
    npm ci --prefix apps/web

# Build and serve the complete local prototype (default http://127.0.0.1:8000)
explore: content
    npm run build --prefix apps/web
    {{ venv_python }} -m apps.api.main

# API and frontend development servers (run in separate terminals; the
# frontend proxy follows the API to whichever port it takes)
api:
    {{ venv_python }} -m apps.api.main

web:
    npm run dev --prefix apps/web

# Domain, ingestion, provider, session, and API tests
check:
    {{ venv_python }} -m pytest -q
    npm run build --prefix apps/web

# Browser acceptance tests; run api and web first
check-browser:
    npm run test:e2e --prefix apps/web

# Standalone local annotation tool (default http://127.0.0.1:8001); never part of the hosted app
curate *args:
    {{ venv_python }} -m tools.curator {{ args }}

# Self-contained browser regression suite with invented source material
check-controls:
    npm run build --prefix apps/web
    MACHINA_BROWSER_FIXTURE=1 npm run test:e2e --prefix apps/web

# Plan or execute private scripted two-character counterfactual experiments
counterfactual *args:
    {{ venv_python }} -m packages.experiments {{ args }}

# Build the independent results dashboard using the existing frontend toolchain
results-build:
    node apps/web/node_modules/vite/bin/vite.js build --config tools/results_dashboard/vite.config.mjs

# Inspect private saved simulations (default http://127.0.0.1:8002)
results *args: results-build
    {{ venv_python }} -m tools.results_dashboard {{ args }}

# Build the private project deck using the existing frontend toolchain
deck-build:
    node apps/web/node_modules/vite/bin/vite.js build --config tools/deck/vite.config.mjs

# Present or edit the local-only deck (default http://127.0.0.1:8003; ?mode=edit to edit)
deck *args: deck-build
    {{ venv_python }} -m tools.deck {{ args }}

# --- Documentation ---

# Build the separate synthetic design playground; no production content is loaded
design-build:
    npm ci --prefix tools/design_preview
    npm run build --prefix tools/design_preview

# Preview landscapes and schematic app states using the shared port registry
design *args: design-build
    {{ venv_python }} -m tools.design_preview {{ args }}

# Browser acceptance for the isolated design preview
check-design: design-build
    node apps/web/node_modules/@playwright/test/cli.js test --config tools/design_preview/playwright.config.mjs

# Preview the human-facing MkDocs site (default http://127.0.0.1:8004);
# install its dependencies with `uv sync --extra docs`
docs *args:
    {{ venv_python }} -m scripts.serve_docs {{ args }}

# Build the documentation site into the ignored site/ directory, failing on warnings
docs-build:
    {{ venv_python }} -m mkdocs build --strict
